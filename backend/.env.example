# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mentorx:mentorx@localhost:5432/mentorx
CORS_ORIGINS=http://localhost:5173

# Auth. In production JWT_SECRET must be 32+ random chars, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# true in production (HTTPS). false for plain-HTTP localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
LOGIN_ATTEMPTS_PER_MINUTE=5
# Per client IP. Raise it for scripts/loadtest.py runs.
REGISTRATIONS_PER_HOUR=10

# Interactive API docs (/docs). Unset = on outside production, off in production.
# EXPOSE_DOCS=

# Question bank: unset = drafts loaded outside production, reviewed-only in production.
# SEED_INCLUDE_DRAFTS=

# Pilot (docs/modules/pilot.md): assign new users to adaptive/control groups (FR-PILOT-01),
# open the post-test at the end, and list the study team's emails (Study page + exports).
PILOT_ACTIVE=false
POSTTEST_OPEN=false
ADMIN_EMAILS=

# --- Adaptive Mathematics tutor (/api/v2) ---
# Folder with FoundationalASSIST Problems.csv + Skills.csv (licensed, never committed).
# Used by scripts/seed_math.py and, if set on the server, by scripts/start.sh.
# MATH_DATA_DIR=C:/Users/me/Downloads
# Exported knowledge-tracing model (committed): dkt_q = DKT-Q (default), dkt = plain DKT.
KT_ARTIFACTS_DIR=model_artifacts/foundationalassist
KT_MODEL=dkt_q
# Assessment and practice lengths
DIAGNOSTIC_LENGTH=10
SKILL_CHECK_LENGTH=6
REASSESSMENT_LENGTH=5
TUTOR_PRACTICE_LENGTH=8
# Diagnosis thresholds (observed accuracy) and reassessment rules
STRENGTH_THRESHOLD=0.75
WEAKNESS_THRESHOLD=0.45
REASSESSMENT_PASS=0.8
IMPROVEMENT_MARGIN=0.15
REVISION_AFTER_DAYS=7
MIXED_PRACTICE_LENGTH=8

# --- AI tutor (optional): explanations and hints through OpenRouter ---
# Empty key = switched off. Never commit the real key.
OPENROUTER_API_KEY=
AI_MODEL=google/gemma-4-26b-a4b-it:free
# tried in order when the main (free) model is busy
AI_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free
AI_DAILY_LIMIT=40
