# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mentorx:mentorx@localhost:5432/mentorx
CORS_ORIGINS=http://localhost:5173

# Auth. In production JWT_SECRET must be 32+ random chars, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# true in production (HTTPS). false for plain-HTTP localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Question bank: unset = drafts loaded outside production, reviewed-only in production.
# SEED_INCLUDE_DRAFTS=

# Pilot: randomly assign new users to adaptive/control groups (FR-PILOT-01).
PILOT_ACTIVE=false
